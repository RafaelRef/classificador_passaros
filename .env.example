# Copie este arquivo para ".env" e preencha com seus valores.
# Nenhum desses é obrigatório para rodar o pipeline em modo mock/console.

# --- Identificação de espécie ---
# Backend a usar: "mock" (padrão, não precisa de nada) ou "inaturalist"
IDENTIFY_BACKEND=mock

# Token de acesso da API do iNaturalist (só necessário se IDENTIFY_BACKEND=inaturalist)
# Como obter: crie uma conta em inaturalist.org, depois gere um JWT em
# https://www.inaturalist.org/users/api_token (fica valido por ~24h). Esse valor
# aqui é só a "semente" inicial: depois de rodar uma vez, o app passa a guardar o
# token atual em data/inaturalist_token.txt, e você renova ele mandando
# "/token SEU_TOKEN_AQUI" no grupo do Telegram (precisa de NOTIFY_BACKEND=telegram
# configurado, veja abaixo) em vez de editar esse arquivo de novo.
INATURALIST_TOKEN=

# --- Notificação ---
# Backend a usar: "console" (padrão, só imprime no terminal) ou "telegram"
NOTIFY_BACKEND=console

# Token do bot do Telegram (só necessário se NOTIFY_BACKEND=telegram)
# Como obter: fale com @BotFather no Telegram, /newbot, siga o passo a passo
TELEGRAM_BOT_TOKEN=

# ID do chat/grupo para onde o bot vai mandar as fotos
# Dica: adicione o bot num grupo com a família, mande uma mensagem no grupo, e use
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates para descobrir o chat_id
TELEGRAM_CHAT_ID=

# --- Captura ---
# Fonte da câmera: "webcam" (padrão, webcam USB do computador) ou "esp32"
# (ESP32-CAM na rede local, servindo JPEG via HTTP)
CAMERA_SOURCE=webcam

# Índice da webcam (0 = webcam padrão do computador). Só usado se CAMERA_SOURCE=webcam
CAMERA_INDEX=0

# URL de captura do ESP32-CAM, ex: http://192.168.0.50/capture
# Só necessário se CAMERA_SOURCE=esp32. É o IP que aparece no Serial Monitor
# quando o firmware (passaros-cam-teste) conecta no Wi-Fi.
ESP32_CAM_URL=

# --- Detecção ---
# "true" (padrão) ignora pessoas (não identifica nem notifica quando é gente
# na câmera, só bicho de verdade). "false" volta a tratar humano como
# qualquer outro ser vivo detectável. Dá pra ligar/desligar só mudando essa
# linha e reiniciando o app, sem mexer em código.
IGNORE_HUMANS=true
