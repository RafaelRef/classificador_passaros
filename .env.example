# Copie este arquivo para ".env" e preencha com seus valores.
# Nenhum desses é obrigatório para rodar o pipeline em modo mock/console.

# --- Identificação de espécie ---
# Backend a usar: "mock" (padrão, não precisa de nada) ou "inaturalist"
IDENTIFY_BACKEND=mock

# Token de acesso da API do iNaturalist (só necessário se IDENTIFY_BACKEND=inaturalist)
# Como obter: crie uma conta em inaturalist.org, depois gere um JWT em
# https://www.inaturalist.org/users/api_token (fica valido por ~24h, dá pra automatizar
# a renovação depois via login OAuth se quiser rodar isso continuamente)
INATURALIST_TOKEN=

# --- Notificação ---
# Backend a usar: "console" (padrão, só imprime no terminal) ou "telegram"
NOTIFY_BACKEND=console

# Token do bot do Telegram (só necessário se NOTIFY_BACKEND=telegram)
# Como obter: fale com @BotFather no Telegram, /newbot, siga o passo a passo
TELEGRAM_BOT_TOKEN=

# ID do chat/grupo para onde o bot vai mandar as fotos
# Dica: adicione o bot num grupo com a família, mande uma mensagem no grupo, e use
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates para descobrir o chat_id
TELEGRAM_CHAT_ID=

# --- Captura ---
# Índice da webcam (0 = webcam padrão do computador)
CAMERA_INDEX=0
